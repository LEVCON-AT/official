# ═══════════════════════════════════════════════════════════════
#  LEVCON.AI STAGING — ENVIRONMENT TEMPLATE
#  Datei: deploy/.env.staging
# ═══════════════════════════════════════════════════════════════
#
#  WICHTIG: Diese Datei wird committed (enthält KEINE Secrets).
#  Echte Werte werden auf dem VPS in /var/www/levcon-staging/.env
#  eingetragen (niemals committen!).
#
#  Setup:
#  1. Auf VPS: cp deploy/.env.staging /var/www/levcon-staging/.env
#  2. Editiere .env: nano /var/www/levcon-staging/.env
#  3. Trage echte Werte ein (LEVCON_INTERNAL_API_KEY generieren, SMTP_PASS etc.)
#  4. chmod 600 /var/www/levcon-staging/.env
#
#  Unterschiede zu Production (.env.production):
#  - DATABASE_URL zeigt auf levcon-staging.db (eigene DB!)
#  - NEXT_PUBLIC_SITE_URL zeigt auf staging.levcon.ai
#  - NEXT_PUBLIC_ENVIRONMENT=staging (aktiviert StagingBanner + noindex)
#  - SMTP_DISABLED=true (Staging versendet KEINE echte Mails!)
#  - Eigener LEVCON_INTERNAL_API_KEY (nicht der Production-Key!)

# ── Database (eigene Staging-DB — NIEMALS Production-DB verwenden!) ───
DATABASE_URL="file:/var/www/levcon-staging/db/levcon-staging.db"

# ── Levcon API-Secret (schützt /api/ai-news/internal/*)
# Generieren: openssl rand -hex 32
# WICHTIG: Anders als Production-Key! Nicht denselben verwenden.
LEVCON_INTERNAL_API_KEY="CHANGE_ME_TO_32_CHARS_RANDOM_STAGING"

# ── Site (Staging-Subdomain)
NEXT_PUBLIC_SITE_URL="https://staging.levcon.ai"

# ── Environment-Kennung (aktiviert StagingBanner + noindex)
# Werte: 'staging' | 'production' (default: production)
NEXT_PUBLIC_ENVIRONMENT="staging"

# ── Contact Form (Staging — Mails gehen an Test-Adresse oder werden verworfen)
CONTACT_EMAIL="albi.enric+staging@gmail.com"

# ── SMTP (IONOS) — STAGING: deaktiviert oder Test-Account
# WICHTIG: Staging darf KEINE echten Newsletter an Subscriber versenden!
# Option A: SMTP_DISABLED=true → API-Routen skippen SMTP-Versand
# Option B: SMTP_PASS auf einen Test-Account setzen (z.B. Mailtrap)
# Production verwendet smtp.ionos.de (nicht smtp.ionos.at!)
SMTP_HOST="smtp.ionos.de"
SMTP_PORT="587"
SMTP_USER="admin@levcon.at"
SMTP_PASS="CHANGE_ME_STAGING_OR_USE_MAILTRAP"
SMTP_FROM="Levcon Staging <admin@levcon.at>"
SMTP_REPLY_TO="hello@levcon.ai"
SMTP_DISABLED="true"

# ── Port (intern für Next.js standalone)
# WICHTIG: 3003 ist durch neonfall belegt, Staging nutzt 3004
PORT="3004"
