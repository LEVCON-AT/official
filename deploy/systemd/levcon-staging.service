# ═══════════════════════════════════════════════════════════════
#  LEVCON.AI — SYSTEMD SERVICE (STAGING)
#  Pfad auf VPS: /etc/systemd/system/levcon-staging.service
# ═══════════════════════════════════════════════════════════════
#
#  Unterschiede zu Production (levcon.service):
#  - Port 3003 (statt 3002) — kein Konflikt mit Production
#  - WorkingDirectory: /var/www/levcon-staging/.next/standalone
#  - EnvironmentFile: /var/www/levcon-staging/.env
#  - Eigener SyslogIdentifier: levcon-staging
#  - Niedrigere Resource Limits (Staging braucht weniger Power)
#  - Eigener User www-data bleibt (System-User, reicht für Staging)
#
#  Nach Installation:
#    sudo systemctl daemon-reload
#    sudo systemctl enable levcon-staging
#    sudo systemctl start levcon-staging
#    sudo systemctl status levcon-staging
#
#  Logs ansehen:
#    journalctl -u levcon-staging -f

[Unit]
Description=Levcon.ai Next.js Application (STAGING)
Documentation=https://github.com/LEVCON-AT/official
After=network.target

[Service]
Type=simple
User=www-data
Group=www-data
WorkingDirectory=/var/www/levcon-staging/.next/standalone
EnvironmentFile=/var/www/levcon-staging/.env

# Start Next.js (Standalone Build)
# WICHTIG: HOSTNAME=0.0.0.0 damit Next.js auf allen Interfaces lauscht
# PORT=3003 — 3000=PDF-Server, 3001=levcon.at coming-soon, 3002=Production
Environment="HOSTNAME=0.0.0.0"
Environment="PORT=3003"
Environment="NODE_ENV=production"

ExecStart=/usr/bin/node /var/www/levcon-staging/.next/standalone/server.js

# Restart Logic
Restart=always
RestartSec=10

# Logging
StandardOutput=journal
StandardError=journal
SyslogIdentifier=levcon-staging

# Resource Limits (niedriger als Production — Staging braucht weniger)
MemoryMax=384M
CPUQuota=60%

# Security Hardening (gleiche wie Production)
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ReadWritePaths=/var/www/levcon-staging
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictRealtime=true
RestrictSUIDSGID=true
LockPersonality=true

[Install]
WantedBy=multi-user.target
